{
  "expo": {
    "name": "Kids Playground",
    "slug": "KidsPlayground",
    "version": "1.0.0",

    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {},
      "bundleIdentifier": "com.skinnymommybear.kidsplayground"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6741D9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.skinnymommybear.kidsplayground",
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-image",
      "expo-font",
      "expo-audio",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#6741D9"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5145202325745375~1521225871",
          "iosAppId": "ca-app-pub-3381041851241163~3333333333"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0abb3259-8fa3-431b-adf3-97454c33c055"
      }
    }
  }
}
